# Aura Stays Mumbai - Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database URL:
# For local SQLite: "file:./dev.db"
# For Render / PostgreSQL: "postgresql://user:password@host:5432/aura_stays?sslmode=require"
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="replace-with-a-very-long-secure-random-string"
JWT_REFRESH_SECRET="replace-with-another-very-long-secure-random-string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Origin for CORS
CLIENT_URL="http://localhost:5173"

# Currency normalization base exchange rate (USD to INR)
EXCHANGE_RATE_USD_TO_INR=84
